#!/bin/sh
# Direct pushes to main are forbidden: push a branch and open a pull request.
# Every other push runs the full local gate first; remote CI only runs static checks.
pushing=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are forbidden; push a branch and open a pull request." >&2
    exit 1
  fi
  case "$local_sha" in
    *[!0]*) pushing=1 ;; # branch deletions carry an all-zero sha
  esac
done
[ "$pushing" = 1 ] || exit 0
echo "pre-push: running the full local gate (npm run harness)..." >&2
npm run harness || {
  echo "pre-push: the local gate failed; fix it before pushing." >&2
  exit 1
}
