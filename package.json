{
  "name": "cat-city",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json --noEmit",
    "lint": "npm run lint:code && prettier --check . && npm run lint:unused",
    "format": "prettier --write .",
    "test": "vitest run tests/unit",
    "test:simulation": "vitest run tests/simulation",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4178 --strictPort",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run test:e2e",
    "harness": "tsx harness/run.ts",
    "replay": "tsx harness/adapters/catcity/replay.ts",
    "device-trace": "tsx harness/adapters/catcity/device-trace-cli.ts",
    "lint:code": "eslint .",
    "lint:unused": "knip",
    "test:coverage": "vitest run --coverage",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.11.0",
    "globals": "^16.3.0",
    "knip": "6.38.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^6.3.6",
    "vitest": "4.1.11"
  }
}
